generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ORGANIZER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  FINISHED
  CANCELED
}

enum TransactionStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

enum CouponSource {
  REFERRAL
}

enum PointType {
  CREDIT
  DEBIT
}

enum PointSource {
  REFERRAL_REWARD
  TRANSACTION_USE
  TRANSACTION_REFUND
  EXPIRED
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String           @map("password_hash")
  role             UserRole         @default(CUSTOMER)
  referralCode     String           @unique @map("referral_code")
  points           Int              @default(0)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")

  profile          Profile?
  pointsHistory    PointsHistory[]
  sentReferrals    ReferralUsage[]  @relation("ReferrerUsage")
  receivedReferral ReferralUsage?   @relation("ReferredUserUsage")
  passwordResets   PasswordReset[]
  refreshTokens    RefreshToken[]
  organizedEvents  Event[]          @relation("OrganizerEvents")
  transactions     Transaction[]
  reviews          Review[]
  coupons          Coupon[]

  @@map("users")
}

model Profile {
  userId     String    @id @map("user_id")
  fullName   String?   @map("fullname")
  phone      String?
  photoUrl   String?   @map("photo_url")
  bio        String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model PointsHistory {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  amount          Int
  remainingAmount Int?        @map("remaining_amount")
  type            PointType
  source          PointSource
  referenceType   String?     @map("reference_type")
  referenceId     String?     @map("reference_id")
  expiresAt       DateTime?   @map("expires_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("points_history")
}

model ReferralUsage {
  id              String    @id @default(uuid())
  referrerId      String    @map("referrer_id")
  referredUserId  String    @unique @map("new_user_id")
  couponId        String?   @unique @map("coupon_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  referrer        User      @relation("ReferrerUsage", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser    User      @relation("ReferredUserUsage", fields: [referredUserId], references: [id], onDelete: Cascade)
  coupon          Coupon?   @relation(fields: [couponId], references: [id])

  @@index([referrerId])
  @@map("referral_usages")
}

model PasswordReset {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Event {
  id           String        @id @default(uuid())
  organizerId  String        @map("organizer_id")
  name         String
  description  String?
  category     String
  location     String
  bannerUrl    String?       @map("banner_url")
  startDate    DateTime      @map("start_date")
  endDate      DateTime      @map("end_date")
  status       EventStatus   @default(DRAFT)
  deletedAt    DateTime?     @map("deleted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")

  organizer    User          @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  ticketTypes  TicketType[]
  transactions Transaction[]
  vouchers     Voucher[]
  reviews      Review[]

  @@index([organizerId])
  @@index([category])
  @@index([location])
  @@index([startDate])
  @@map("events")
}

model TicketType {
  id             String             @id @default(uuid())
  eventId        String             @map("event_id")
  name           String
  price          Int
  quota          Int
  availableQuota Int                @map("available_quota")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at")

  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items          TransactionItem[]

  @@index([eventId])
  @@map("ticket_types")
}

model Transaction {
  id                     String             @id @default(uuid())
  userId                 String             @map("user_id")
  eventId                String             @map("event_id")
  voucherId              String?            @map("voucher_id")
  couponId               String?            @map("coupon_id")
  totalAmount            Int                @map("total_amount")
  voucherDiscount        Int                @default(0) @map("voucher_discount")
  couponDiscount         Int                @default(0) @map("coupon_discount")
  pointsUsed             Int                @default(0) @map("points_used")
  finalAmount            Int                @map("final_amount")
  status                 TransactionStatus  @default(WAITING_PAYMENT)
  paymentProofUrl        String?            @map("payment_proof")
  paymentUploadedAt      DateTime?          @map("payment_uploaded_at")
  paymentDeadlineAt      DateTime           @map("payment_deadline_at")
  confirmationDeadlineAt DateTime?          @map("confirmation_deadline_at")
  rejectionReason        String?            @map("rejection_reason")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at")

  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  event                  Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  voucher                Voucher?           @relation(fields: [voucherId], references: [id])
  coupon                 Coupon?            @relation(fields: [couponId], references: [id])
  items                  TransactionItem[]

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("transactions")
}

model TransactionItem {
  id            String       @id @default(uuid())
  transactionId String       @map("transaction_id")
  ticketTypeId  String       @map("ticket_type_id")
  quantity      Int
  price         Int
  subtotal      Int
  createdAt     DateTime     @default(now()) @map("created_at")

  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ticketType    TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([transactionId, ticketTypeId])
  @@map("transaction_items")
}

model Voucher {
  id             String        @id @default(uuid())
  eventId        String        @map("event_id")
  code           String        @unique
  discountAmount Int           @map("discount_value")
  startDate      DateTime      @map("start_date")
  endDate        DateTime      @map("end_date")
  quota          Int?
  usedCount      Int           @default(0) @map("used_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@index([eventId])
  @@map("vouchers")
}

model Coupon {
  id             String         @id @default(uuid())
  code           String         @unique
  source         CouponSource   @default(REFERRAL)
  discountAmount Int            @map("discount")
  validUntil     DateTime       @map("valid_until")
  isUsed         Boolean        @default(false) @map("is_used")
  usedAt         DateTime?      @map("used_at")
  userId         String         @map("user_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  referralUsage  ReferralUsage?

  @@index([userId, isUsed])
  @@map("coupons")
}

model Review {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  eventId    String    @map("event_id")
  rating     Int
  comment    String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("reviews")
}