// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          String    @default("customer")
  referralCode  String    @unique @map("referral_code")
  points        Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  
  profile           Profile?
  pointsHistory     PointsHistory[]
  sentReferrals     ReferralUsage[] @relation("referrer")
  receivedReferrals ReferralUsage[] @relation("newUser")
  passwordResets    PasswordReset[]
  organizedEvents   Event[]    @relation("organizer")
  transactions      Transaction[]
  reviews           Review[]
  coupons           Coupon[]
  
  @@map("users")
}

model Profile {
  userId    String   @id @map("user_id")
  fullname  String?
  phone     String?
  photoUrl  String?  @map("photo_url")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("profiles")
}

model PointsHistory {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  amount    Int
  source    String
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("points_history")
}

model ReferralUsage {
  id          Int      @id @default(autoincrement())
  referrerId  String   @map("referrer_id")
  newUserId   String   @unique @map("new_user_id")
  couponCode  String?  @map("coupon_code")
  createdAt   DateTime @default(now()) @map("created_at")
  
  referrer    User     @relation("referrer", fields: [referrerId], references: [id])
  newUser     User     @relation("newUser", fields: [newUserId], references: [id])
  
  @@map("referral_usages")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("password_resets")
}

model Event {
  id             String    @id @default(uuid())
  organizerId    String    @map("organizer_id")
  name           String
  description    String?
  category       String?
  location       String?
  startDate      DateTime  @map("start_date")
  endDate        DateTime  @map("end_date")
  availableSeats Int       @map("available_seats")
  price          Int       @default(0)
  status         String    @default("draft")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  
  organizer      User           @relation("organizer", fields: [organizerId], references: [id])
  ticketTypes    TicketType[]
  transactions   Transaction[]
  vouchers       Voucher[]
  reviews        Review[]
  
  @@map("events")
}

model TicketType {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  name      String
  price     Int
  quota     Int
  createdAt DateTime @default(now()) @map("created_at")
  
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items     TransactionItem[]
  
  @@map("ticket_types")
}

model Transaction {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  eventId      String   @map("event_id")
  totalAmount  Int      @map("total_amount")
  pointsUsed   Int      @default(0) @map("points_used")
  finalAmount  Int      @map("final_amount")
  status       String   @default("waiting_for_payment")
  paymentProof String?  @map("payment_proof")
  expiredAt    DateTime @map("expired_at")
  createdAt    DateTime @default(now()) @map("created_at")
  
  user         User              @relation(fields: [userId], references: [id])
  event        Event             @relation(fields: [eventId], references: [id])
  items        TransactionItem[]
  
  @@map("transactions")
}

model TransactionItem {
  id             String   @id @default(uuid())
  transactionId  String   @map("transaction_id")
  ticketTypeId   String   @map("ticket_type_id")
  quantity       Int
  subtotal       Int
  createdAt      DateTime @default(now()) @map("created_at")
  
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ticketType     TicketType  @relation(fields: [ticketTypeId], references: [id])
  
  @@map("transaction_items")
}

model Voucher {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  code          String   @unique
  discountType  String   @map("discount_type")
  discountValue Int      @map("discount_value")
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  createdAt     DateTime @default(now()) @map("created_at")
  
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@map("vouchers")
}

model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique
  discount    Int
  validUntil  DateTime @map("valid_until")
  isUsed      Boolean  @default(false) @map("is_used")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@map("coupons")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
  
  @@unique([userId, eventId])
  @@map("reviews")
}